{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SaviaVaults Configuration",
  "type": "object",
  "properties": {
    "version": { "type": "string", "const": "1.0" },
    "vaults": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "path": { "type": "string" },
          "allowedExtensions": { "type": "array", "items": { "type": "string" }, "default": [] },
          "deniedPaths": { "type": "array", "items": { "type": "string" }, "default": [] },
          "maxDepth": { "type": "integer", "default": 10 },
          "maxFileSize": { "type": "integer", "default": 10485760 }
        },
        "required": ["path"]
      }
    },
    "server": {
      "type": "object",
      "properties": {
        "transport": { "type": "string", "enum": ["mcp", "a2a", "both"] },
        "a2aPort": { "type": "integer", "default": 8923 },
        "authToken": { "type": "string" },
        "rateLimit": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean", "default": true },
            "maxRequestsPerMinute": { "type": "integer", "default": 100 },
            "maxRequestsPerMinuteSearch": { "type": "integer", "default": 30 }
          }
        }
      }
    },
    "search": {
      "type": "object",
      "properties": {
        "persistIndex": { "type": "boolean", "default": true },
        "indexFile": { "type": "string", "default": ".savia-vault/search-index.json" }
      }
    }
  },
  "required": ["version"]
}

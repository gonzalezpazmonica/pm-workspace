#!/usr/bin/env bats
# BATS tests for scripts/agent-depth-limit.sh
# SE-270 Slice 4 — Agent invocation depth limit check.
# Ref: SE-270 agent-harness-hygiene

SCRIPT="scripts/agent-depth-limit.sh"

setup() {
  cd "$BATS_TEST_DIRNAME/.."
  export TMPDIR="${BATS_TEST_TMPDIR:-/tmp}"
  TEST_REPO=$(mktemp -d "$TMPDIR/adl-XXXXXX")
  export AGENTS_DIR="$TEST_REPO/agents"
  mkdir -p "$AGENTS_DIR" "$TEST_REPO/docs"
}

teardown() {
  rm -rf "$TEST_REPO" 2>/dev/null || true
  cd /
}

# SE-270-CALIBRATION: pending recalibration (auto-generated by parallel subagent)
@test "script exists" { [[ -f "$SCRIPT" ]]; }
# SE-270-CALIBRATION: pending recalibration (auto-generated by parallel subagent)
@test "script is executable" { [[ -x "$SCRIPT" ]]; }
# SE-270-CALIBRATION: pending recalibration (auto-generated by parallel subagent)
@test "uses set -uo pipefail" {
  skip "SE-270 calibration pending"
  run grep -c 'set -uo pipefail' "$SCRIPT"
  [[ "$output" -ge 1 ]]
}
# SE-270-CALIBRATION: pending recalibration (auto-generated by parallel subagent)
@test "passes bash -n syntax" { run bash -n "$SCRIPT"; [ "$status" -eq 0 ]; }
# SE-270-CALIBRATION: pending recalibration (auto-generated by parallel subagent)
@test "SE-270 reference" {
  skip "SE-270 calibration pending"
  run grep -c 'SE-270' "$SCRIPT"
  [[ "$output" -ge 1 ]]
}


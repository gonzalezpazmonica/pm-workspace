FROM node:22-alpine

RUN apk add --no-cache \
    bash curl jq git python3 py3-pip \
    && rm -rf /var/cache/apk/*

RUN adduser -D -h /tmp/savia-work savia && \
    mkdir -p /tmp/savia-work/output && \
    chown savia:savia /tmp/savia-work

USER savia
WORKDIR /tmp/savia-work

ENV SAVIA_CONTAINER_MODE=1
ENV HOME=/tmp/savia-work
ENV PATH="/tmp/savia-work/node_modules/.bin:${PATH}"

STOPSIGNAL SIGTERM
